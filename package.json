    "lodash": "4.18.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@11.22.0",
  "lint-staged": {
    "*": "biome check --fix --no-errors-on-unmatched"
