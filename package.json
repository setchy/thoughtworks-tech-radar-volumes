{
  "name": "thoughtworks-tech-radar-volumes",
  "version": "1.0.0",
  "private": true,
  "description": "CLI and complete volume dataset for Thoughtworks Technology Radars",
  "author": "Adam Setch @setchy",
  "homepage": "https://github.com/setchy/thoughtworks-tech-radar-volumes",
  "license": "ISC",
  "type": "module",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/setchy/thoughtworks-tech-radar-volumes"
  },
  "bugs": {
    "url": "https://github.com/setchy/thoughtworks-tech-radar-volumes/issues"
  },
  "keywords": [
    "tech-radar"
  ],
  "scripts": {
    "start": "node src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --fix .",
    "lint:check": "biome lint .",
    "lint:ci": "biome ci --reporter=github",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=github-actions"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tsconfig/node24": "24.0.5",
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.6",
    "cheerio": "1.2.0",
    "commander": "15.1.0",
    "dotenv": "18.0.9",
    "googleapis": "189.0.0",
    "lodash": "4.18.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "26"
  },
  "lint-staged": {
    "*": "biome check --fix --no-errors-on-unmatched"
  }
}
