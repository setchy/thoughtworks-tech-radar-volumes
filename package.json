{
  "name": "thoughtworks-tech-radar-volumes",
  "version": "1.0.0",
  "private": true,
  "description": "CLI and complete volume dataset for Thoughtworks Technology Radars",
  "author": "Adam Setch @setchy",
  "homepage": "https://github.com/setchy/thoughtworks-tech-radar-volumes",
  "license": "ISC",
  "type": "module",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/setchy/thoughtworks-tech-radar-volumes"
  },
  "bugs": {
    "url": "https://github.com/setchy/thoughtworks-tech-radar-volumes/issues"
  },
  "keywords": [
    "tech-radar"
  ],
  "scripts": {
    "start": "node src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --fix",
    "lint:check": "biome check",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tsconfig/node24": "24.0.5",
    "@types/lodash": "4.17.27",
    "@types/node": "24.19.2",
    "cheerio": "1.2.0",
    "commander": "15.0.0",
    "dotenv": "18.0.9",
    "googleapis": "188.0.0",
    "lodash": "4.18.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24"
  },
  "lint-staged": {
    "*": "biome check --fix --no-errors-on-unmatched"
  }
}
